# ───── 마음결 서버 설정 (이 파일을 .env 로 복사해서 사용) ─────
PORT=3000
BASE_URL=http://localhost:3000
SITE_NAME=마음결
# NODE_ENV=production   # 운영 시 주석 해제 (HTTPS 쿠키, 인증번호 화면 표시 끔)

# 최초 관리자 계정 (메일 + 연락처로 로그인)
ADMIN_EMAIL=admin@maeumgyeol.local
ADMIN_PHONE=010-0000-0000
ADMIN_NAME=관리자

# 교사 회원가입 인증코드 (교사로 가입할 때 입력해야 함)
TEACHER_CODE=maum2026

# 위기 알림을 받을 메일 (쉼표로 여러 개, 비우면 관리자 계정 메일로 발송)
ALERT_EMAILS=

# 메일 발송(SMTP) — 비워 두면 개발 모드: 메일은 관리자 '메일함'에 저장되고 인증번호가 화면에 표시됨
# Gmail 예시: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true (앱 비밀번호 사용)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="마음결 <no-reply@example.com>"

# 데이터 암호화 키 (base64 32바이트). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 비우면 data/.data_key 가 자동 생성됩니다. 키를 잃어버리면 상담 내용을 복호화할 수 없으니 꼭 백업하세요.
DATA_KEY=

# (선택) Claude API — 그림 AI 해석, 내담자 상태 AI 요약
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
